rules_version = '2';

// Only needed if ENABLE_UPLOADS = true in js/config.js (requires the Blaze plan).
// Paste into Firebase console → Storage → Rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /maps/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['christopherwmazzoli@gmail.com']
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
