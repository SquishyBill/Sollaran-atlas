rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who's who ───────────────────────────────────────────────────
    // The DM: keep in sync with DM_EMAILS in js/config.js.
    function dmEmails() { return ['christopherwmazzoli@gmail.com']; }

    // The party. Leave the list EMPTY to let anyone with a Google account in.
    // Once you have everyone's address, list them (lowercase), e.g.
    //   return ['player.one@gmail.com', 'player.two@gmail.com'];
    // then Publish. No site redeploy needed.
    function party() {
      return [
        'dylansander6@gmail.com',
        'jason@hamburger.bz',
        'jeffreyrandrews6@gmail.com',
        'kctrost@gmail.com',
        'trost5.kt@gmail.com',
        'kencroes@gmail.com',
        'medeski1976@gmail.com',
        'rodney.j.saunders@gmail.com',
        'sebastian.zedka@gmail.com'
      ];
    }

    function googleUser() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    function isDM() { return googleUser() && request.auth.token.email.lower() in dmEmails(); }

    // The scribe(s): players the DM has named (config/scribes holds their emails) who may write the session journal.
    function isScribe() {
      return googleUser()
        && exists(/databases/$(database)/documents/config/scribes)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/scribes).data.emails;
    }

    function isPlayer() {
      return googleUser()
        && (party().size() == 0 || request.auth.token.email.lower() in party() || isDM());
    }

    // Pages and pins: everyone reads what isn't hidden; only the DM writes.
    match /pages/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.hidden == false);
      allow write: if isDM();
    }

    match /pins/{id} {
      allow read: if isDM()
        || (isPlayer() && resource.data.hidden == false && resource.data.pageHidden == false);
      allow write: if isDM();
    }

    // People (NPCs): everyone reads who isn't hidden; only the DM writes.
    match /people/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.hidden == false);
      allow write: if isDM();
    }

    // Pictures for pins and pages (keyed by the pin/page id, fetched only when shown).
    // Players only get a picture if its pin or page isn't hidden from them.
    function pinVisible(id) {
      let pin = get(/databases/$(database)/documents/pins/$(id)).data;
      return pin.hidden == false && pin.pageHidden == false;
    }
    function pageVisible(id) {
      return get(/databases/$(database)/documents/pages/$(id)).data.hidden == false;
    }
    match /pictures/{id} {
      allow read: if isDM() || (isPlayer() && (
        (resource.data.kind == 'pin' && pinVisible(id)) || (resource.data.kind == 'page' && pageVisible(id))));
      allow write: if isDM();
    }

    // Party renown: a standing per place/group, its change log, and the tier definitions.
    // Players see standings (and their history) unless the DM has hidden them.
    match /renown/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.hidden == false);
      allow write: if isDM();
    }
    match /renownLog/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.hidden == false);
      allow write: if isDM();
    }
    match /config/{id} {
      allow read: if isPlayer();
      allow write: if isDM();
    }

    // The calendar's date lives in config/calendar (above). Holidays the DM adds: everyone reads the ones that
    // aren't hidden. The history of every move of the date is the DM's alone.
    match /holidays/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.hidden == false);
      allow write: if isDM();
    }
    match /calendarLog/{id} { allow read, write: if isDM(); }

    // Shops: generated by the DM; players see the ones that aren't hidden.
    match /shops/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.hidden == false);
      allow write: if isDM();
    }

    // A purchase or sale that was paid from (or into) the player's backpack is settled at once. It has to
    // name the ledger line (logId) written in the same step, so the DM can always match the two up.
    function paidFromBackpack() {
      return request.resource.data.settled == true
        && request.resource.data.get('paid', '') == 'backpack'
        && request.resource.data.get('logId', '') is string
        && existsAfter(/databases/$(database)/documents/backpackLog/$(request.resource.data.logId));
    }

    // Purchases: any player can buy (recorded under their own account); everyone can read them
    // (stock is worked out from them); only the DM can mark them settled or void them.
    match /purchases/{id} {
      allow read: if isPlayer();
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['shopId', 'week', 'itemKey', 'itemName', 'qty', 'unitPrice', 'total', 'buyer', 'buyerUid', 'at', 'settled', 'haggle', 'paid', 'logId'])
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.shopId is string
        && request.resource.data.qty is int && request.resource.data.qty > 0 && request.resource.data.qty <= 1000
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.buyer is string && request.resource.data.buyer.size() <= 60
        && (request.resource.data.settled == false || paidFromBackpack());
      allow update, delete: if isDM();
    }

    // Haggling: one attempt per player, per shop, per week (the id is shop__player__week, and
    // there's no update rule, so a second attempt is refused). Only the DM can reset one.
    match /haggles/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.uid == request.auth.uid);
      allow create: if isPlayer()
        && id == request.resource.data.shopId + '__' + request.auth.uid + '__' + string(request.resource.data.week)
        && request.resource.data.keys().hasOnly(['shopId', 'week', 'uid', 'buyer', 'roll', 'die', 'bonus', 'mult', 'at'])
        && request.resource.data.uid == request.auth.uid
        // the atlas rolls the d20; the bonus must be the one on record and the total must add up
        && request.resource.data.die is int && request.resource.data.die >= 1 && request.resource.data.die <= 20
        && request.resource.data.bonus == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.persuasion
        && request.resource.data.roll == request.resource.data.die + request.resource.data.bonus
        && request.resource.data.mult is number && request.resource.data.mult >= 0.8 && request.resource.data.mult <= 1.2;
      allow delete: if isDM();
    }

    // Each player's record: their Persuasion bonus for haggling. A player sets it once;
    // after that only the DM can change it.
    match /players/{uid} {
      allow read: if isDM() || (isPlayer() && request.auth.uid == uid);
      allow create: if isPlayer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'persuasion', 'setAt'])
        && request.resource.data.persuasion is int && request.resource.data.persuasion >= -5 && request.resource.data.persuasion <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update, delete: if isDM();
    }

    // Loot: the party's shared stash. Everyone can see it; only the DM changes it, except that a
    // player may send an unidentified item off to be identified (after paying a shop for it).
    match /loot/{id} {
      allow read: if isPlayer();
      // Anything a player buys lands here as "goods" (under their own name). Unclaimed goods can be sold
      // by any player, which removes them or lowers the quantity. Everything else is the DM's.
      allow create: if isDM() || (isPlayer()
        && request.resource.data.kind == 'goods' && request.resource.data.status == 'identified'
        && request.resource.data.boughtByUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'name', 'detail', 'value', 'cost', 'qty', 'status', 'source', 'boughtBy', 'boughtByUid', 'boughtAt', 'foundAt', 'cat', 'fromPlace', 'holderUid', 'claimedBy', 'claimedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 160
        && request.resource.data.qty is int && request.resource.data.qty > 0 && request.resource.data.qty <= 1000
        && request.resource.data.value is number && request.resource.data.value >= 0
        && request.resource.data.cost is number && request.resource.data.cost >= 0
        && heldByBuyerOnly())
        // a Writ of Exchange from the G.E.C. (a paper anyone can cash, so it lives in the stash like any item)
        || (isPlayer()
        && request.resource.data.kind == 'writ' && request.resource.data.status == 'identified'
        && request.resource.data.boughtByUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'name', 'detail', 'value', 'cost', 'qty', 'status', 'source', 'boughtBy', 'boughtByUid', 'boughtAt', 'foundAt', 'cat', 'fromPlace', 'issuedShop', 'holderUid', 'claimedBy', 'claimedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 160
        && request.resource.data.qty == 1
        && request.resource.data.value is number && request.resource.data.value >= 1 && request.resource.data.value <= 50000
        && request.resource.data.cost is number && request.resource.data.cost >= 0
        && heldByBuyerOnly());
      // A player can remove (sell, cash in) what is theirs: unclaimed goods, any writ, or anything in their own backpack.
      allow delete: if isDM() || (isPlayer()
        && ((resource.data.kind == 'goods' && resource.data.get('claimedBy', null) == null)
          // a writ is a paper whoever holds it can cash, unless it is in somebody's backpack
          || (resource.data.kind == 'writ' && (!('holderUid' in resource.data) || resource.data.holderUid == request.auth.uid))
          || (resource.data.kind in ['goods', 'writ'] && resource.data.get('holderUid', null) == request.auth.uid)));
      allow update: if isDM()
        || (isPlayer()
          && resource.data.status == 'unidentified' && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pendingBy', 'pendingAt', 'pendingIn']))
        || (isPlayer()
          && resource.data.kind == 'goods'
          && (resource.data.get('claimedBy', null) == null || resource.data.get('holderUid', null) == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
          && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty < resource.data.qty);
    }

    // What a player buys can go straight into their own backpack: if it says who holds it, that must be them.
    function heldByBuyerOnly() {
      return (!('holderUid' in request.resource.data) || request.resource.data.holderUid == request.auth.uid)
        && (!('claimedBy' in request.resource.data) || ('holderUid' in request.resource.data && request.resource.data.claimedBy is string && request.resource.data.claimedBy.size() <= 60))
        && (!('claimedAt' in request.resource.data) || ('holderUid' in request.resource.data && request.resource.data.claimedAt is number));
    }

    // G.E.C. savings accounts and safety-deposit boxes: one per player per branch (the id is shop__player).
    // Only the owner and the DM can read or change one. The DM can close an account.
    function accountOk() {
      return request.resource.data.keys().hasOnly(['shopId', 'uid', 'owner', 'balance', 'since', 'boxes', 'log', 'gamble'])
        && request.resource.data.shopId is string
        && request.resource.data.owner is string && request.resource.data.owner.size() <= 60
        && request.resource.data.balance is int && request.resource.data.balance >= 0 && request.resource.data.balance <= 1000000000
        && request.resource.data.since is number
        && request.resource.data.boxes is list && request.resource.data.boxes.size() <= 12
        && request.resource.data.log is list && request.resource.data.log.size() <= 30
        // the day's winnings at each gaming house (a map of house id -> { day, net })
        && (!('gamble' in request.resource.data) || (request.resource.data.gamble is map && request.resource.data.gamble.size() <= 20));
    }
    match /accounts/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.uid == request.auth.uid);
      allow create: if isDM() || (isPlayer() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.shopId + '__' + request.auth.uid && accountOk());
      allow update: if isDM() || (isPlayer() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid && request.resource.data.shopId == resource.data.shopId && accountOk());
      allow delete: if isDM();
    }

    // ── Backpacks ───────────────────────────────────────────────────
    // Each player has one backpack document (backpacks/<their uid>) holding their coins; what they carry
    // is in loot (marked with holderUid). Only the owner and the DM can read it. A player can change only
    // their own, and every change to the coins has to come with a matching line in backpackLog, written
    // in the same step (named in lastLog), so the DM can always see where coins went:
    //   - coins can go down for any ordinary spend (a purchase, a fee, a deposit...);
    //   - coins can only go UP by a sale (the sale record must be in the same step), a writ cashed
    //     (the writ must be used up) or a savings withdrawal (the account must go down by as much).
    // The DM can change anything. This stops mistakes and casual poking, not a determined cheat: the price
    // itself is worked out by the page, and the DM can see every move in the ledger.
    function coinSum(c) { return c.pp * 1000 + c.gp * 100 + c.sp * 10 + c.cp; }
    function coinsOk(c) {
      return c is map && c.keys().hasOnly(['pp', 'gp', 'sp', 'cp'])
        && c.pp is int && c.pp >= 0 && c.gp is int && c.gp >= 0 && c.sp is int && c.sp >= 0 && c.cp is int && c.cp >= 0
        && coinSum(c) <= 1000000000;
    }
    // The gaming tally: what a player has won (or lost) at each house today, kept in their backpack as
    // gamble: { <house id>: { day, net } } (copper; day counts days since 1970, UTC) so a house's daily limit can't be
    // dodged by playing from the backpack instead of the savings account. A bet moves it by exactly what the bet won
    // or lost, and a win can't take it past the limit for that size of house (the limits in js/gaming-data.js).
    function winCap(size) { return size == 1 ? 1000 : size == 2 ? 2500 : size == 3 ? 10000 : size == 4 ? 40000 : 150000; }
    function gambleBefore() { return resource == null ? {} : resource.data.get('gamble', {}); }
    function betOk(d, house, delta) {
      let prev = gambleBefore().get(house, {'day': -99, 'net': 0});
      let now = d.gamble[house];
      return d.gamble.size() <= 20
        && d.gamble.diff(gambleBefore()).affectedKeys().hasOnly([house])
        && now.keys().hasOnly(['day', 'net']) && now.day is int && now.net is int
        && now.net == (prev.day == now.day ? prev.net : 0) + delta
        && math.abs(now.day - math.floor(request.time.toMillis() / 86400000)) <= 1
        && (delta <= 0 || now.net <= winCap(get(/databases/$(database)/documents/shops/$(house)).data.size));
    }
    function moveOk(d, before, after) {
      let log = getAfter(/databases/$(database)/documents/backpackLog/$(d.lastLog)).data;
      let delta = after - before;
      return log.uid == d.uid && log.deltaCp == delta && log.balanceCp == after
        // only a bet can touch the gaming tally, and a bet has to keep it true
        && (log.kind == 'bet' ? betOk(d, log.ref, delta) : d.get('gamble', {}) == gambleBefore())
        && (delta == 0
          ? log.kind == 'bet'
          : delta < 0
          ? !(log.kind in ['sell', 'writ', 'withdraw', 'loot', 'split', 'award', 'fromHome', 'start', 'set', 'take'])
          : (log.kind == 'bet')
            || (log.kind == 'sell'
              && getAfter(/databases/$(database)/documents/sales/$(log.ref)).data.buyerUid == d.uid
              && math.round(getAfter(/databases/$(database)/documents/sales/$(log.ref)).data.total * 100) == delta)
            || (log.kind == 'writ'
              && exists(/databases/$(database)/documents/loot/$(log.ref))
              && !existsAfter(/databases/$(database)/documents/loot/$(log.ref))
              && math.round(get(/databases/$(database)/documents/loot/$(log.ref)).data.value * 100) == delta)
            || (log.kind == 'withdraw'
              && getAfter(/databases/$(database)/documents/accounts/$(log.ref)).data.uid == d.uid
              && get(/databases/$(database)/documents/accounts/$(log.ref)).data.balance
                   - getAfter(/databases/$(database)/documents/accounts/$(log.ref)).data.balance
                   + get(/databases/$(database)/documents/accounts/$(log.ref)).data.balance
                     * (math.pow(1.0301, math.floor((getAfter(/databases/$(database)/documents/accounts/$(log.ref)).data.since
                                                     - get(/databases/$(database)/documents/accounts/$(log.ref)).data.since) / 2592000000)) - 1)
                   >= delta));
    }
    function backpackOk(uid) {
      let d = request.resource.data;
      let before = resource == null ? 0 : coinSum(resource.data.coins);
      let after = coinSum(d.coins);
      let gambled = d.get('gamble', {}) != gambleBefore();
      return d.keys().hasOnly(['uid', 'owner', 'coins', 'lastLog', 'updatedAt', 'gamble'])
        && d.uid == uid && d.owner is string && d.owner.size() <= 60
        && coinsOk(d.coins)
        && d.get('gamble', {}) is map
        && ((after == before && !gambled) || (d.lastLog is string && moveOk(d, before, after)));
    }
    match /backpacks/{uid} {
      allow read: if isDM() || (isPlayer() && request.auth.uid == uid);
      allow create, update: if isDM() || (isPlayer() && request.auth.uid == uid && backpackOk(uid));
      allow delete: if isDM();
    }
    match /backpackLog/{id} {
      allow read: if isDM() || (isPlayer() && resource.data.uid == request.auth.uid);
      allow create: if isDM() || (isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'owner', 'kind', 'deltaCp', 'balanceCp', 'text', 'ref', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.owner is string && request.resource.data.owner.size() <= 60
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 20
        && request.resource.data.deltaCp is int && request.resource.data.balanceCp is int && request.resource.data.balanceCp >= 0
        && request.resource.data.text is string && request.resource.data.text.size() <= 240
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 120
        && request.resource.data.at is number);
      allow update, delete: if isDM();
    }

    // Sales: a player selling goods to a shop. Everyone can read them (a shop's weekly appetite is worked
    // out from them); only the DM can mark one settled or void it.
    match /sales/{id} {
      allow read: if isPlayer();
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['shopId', 'week', 'itemName', 'qty', 'unitPrice', 'total', 'cost', 'buyer', 'buyerUid', 'at', 'settled', 'paid', 'logId'])
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.shopId is string
        && request.resource.data.itemName is string && request.resource.data.itemName.size() <= 200
        && request.resource.data.qty is int && request.resource.data.qty > 0 && request.resource.data.qty <= 1000
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total <= 100000
        && request.resource.data.buyer is string && request.resource.data.buyer.size() <= 60
        && (request.resource.data.settled == false || paidFromBackpack());
      allow update, delete: if isDM();
    }
    match /lootLog/{id} {
      allow read: if isPlayer();
      allow write: if isDM();
    }
    match /party/{id} {
      allow read: if isPlayer();
      allow write: if isDM();
    }
    // What unidentified items really are, hidden caches, and the homebrew library: DM only.
    match /lootTruth/{id} { allow read, write: if isDM(); }
    match /caches/{id} { allow read, write: if isDM(); }
    match /magicItems/{id} { allow read, write: if isDM(); }
    // Homebrew items the DM allows in shops: name, rarity and price only.
    match /magicPublic/{id} {
      allow read: if isPlayer();
      allow write: if isDM();
    }

    // DM-only secrets for pins, pages and people (keyed by their id). Never readable by players.
    match /secrets/{id} {
      allow read, write: if isDM();
    }

    // Session journal: scribes and the DM write it; everyone in the party reads what is published.
    // Drafts (draft == true) are for the scribes and the DM alone.
    function journalOk() {
      return request.resource.data.keys().hasOnly(['n', 'date', 'title', 'body', 'draft', 'author', 'createdAt', 'editedAt'])
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 9999
        && request.resource.data.date is string && request.resource.data.date.size() <= 12
        && request.resource.data.title is string && request.resource.data.title.size() <= 160
        && request.resource.data.body is string && request.resource.data.body.size() <= 100000
        && request.resource.data.draft is bool
        && request.resource.data.author is string && request.resource.data.author.size() <= 60;
    }
    match /journal/{id} {
      allow read: if isDM() || isScribe() || (isPlayer() && resource.data.draft == false);
      allow create, update: if isDM() || (isScribe() && journalOk());
      allow delete: if isDM() || isScribe();
    }

    // Notes: every player can write their own.
    // Private notes are readable only by their author, not even the DM.
    match /notes/{id} {
      allow read: if isPlayer() && (resource.data.private == false || resource.data.uid == request.auth.uid);

      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'text', 'author', 'private', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetType in ['pin', 'page', 'person', 'shop', 'journal']
        && request.resource.data.targetId is string
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
        && request.resource.data.author is string && request.resource.data.author.size() <= 60
        && request.resource.data.private is bool;

      allow update: if isPlayer()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;

      allow delete: if isDM() || (isPlayer() && resource.data.uid == request.auth.uid);
    }

    // Live "ping" shared by everyone at the table.
    match /live/ping {
      allow read: if isPlayer();
      allow write: if isPlayer()
        && request.resource.data.keys().hasOnly(['pageId', 'x', 'y', 'by', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.by is string && request.resource.data.by.size() <= 60;
    }
  }
}
